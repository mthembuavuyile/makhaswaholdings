# =============================================================================
# Gitignore for Makhaswa Holdings
# =============================================================================

# Operating System Files
# ----------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Development & Editors
# ---------------------
# VS Code
.vscode/
*.code-workspace

# JetBrains / IntelliJ / WebStorm
.idea/
*.iws
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs backup & swap files
*.swp
*.swo
*.tmp
*.temp
*~
.#*
#*#

# Dependencies & Package Managers
# -------------------------------
node_modules/
jspm_packages/
.pnpm-store/

# Logs & Diagnostics
# ------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets
# -------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json

# Build & Cache Directories
# -------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.sass-cache/
.temp/

# Backup & Scratch Files
# ----------------------
*.bak
*.backup
*.orig
*.rej
